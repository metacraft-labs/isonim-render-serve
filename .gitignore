# Build / test outputs.
test-logs/
nim-cache/
bench-results/
# `repro build` / `repro test` write the test binaries repro.nim declares
# under build/test-bin/. Left untracked and unignored, they dirty the tree
# and `repro test` refuses to certify a run whose inputs include them.
/build/

# direnv local state.
.direnv/

# Compiled test binaries.
tests/test_*
!tests/test_*.nim
!tests/test_*.cfg
!tests/test_*.sh

# Nim caches.
*.dSYM
*.exe
*.pdb
nimcache/
# Per-checkout nimcache (config.nims): every Nim compile in this checkout
# keeps its intermediate files here, never in the shared ~/.cache/nim.
.nimcache/
.repro/

